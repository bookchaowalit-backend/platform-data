{
  "$schema": "./schema/book-platform.contract.v1.schema.json",
  "schema_version": "book-platform.contract.v1",
  "platform_id": "data",
  "repository": "platform-data",
  "status": "pilot",
  "api_version": "v1",
  "data_owner": "platform-data",
  "capabilities": [
    "event-ingress",
    "lake-contract",
    "query",
    "analytics",
    "lineage",
    "workspace-cache",
    "atomic-counters",
    "document-search",
    "quota-reservations"
  ],
  "depends_on": [
    "security",
    "observability"
  ],
  "current_implementation": {
    "repository": "platform-data",
    "source_path": "src/platform_data",
    "source_paths": [
      "src/platform_data"
    ],
    "source_status": "implemented-in-this-repository"
  },
  "migration": {
    "compatibility_adapter": "required",
    "shadow_parity": "pending",
    "cutover": "pending",
    "rollback": "required"
  },
  "migration_gates": [
    "bronze parity",
    "schema versioning",
    "replay evidence"
  ],
  "surface_doc": "docs/CONTRACT-SURFACE.md",
  "interfaces": [
    {
      "id": "data.cli.ingest",
      "kind": "cli",
      "direction": "provides",
      "name": "python infra/scripts/data_lake/ingest.py --input --source --domain --dataset",
      "status": "current-in-solo-empire",
      "source": "infra/scripts/data_lake/ingest.py"
    },
    {
      "id": "data.object-store.landing",
      "kind": "object-store",
      "direction": "provides",
      "name": "landing/source=<source>[/provider=<p>]/batch_id=<id>/payload.<ext>",
      "status": "current-in-solo-empire",
      "source": "infra/scripts/data_lake/ingest.py"
    },
    {
      "id": "data.object-store.bronze",
      "kind": "object-store",
      "direction": "provides",
      "name": "bronze/domain=<d>/dataset=<ds>/schema_version=<v>/ingest_date=<date>/source=<s>/part-<batch>.parquet",
      "status": "current-in-solo-empire",
      "source": "infra/scripts/data_lake/parquet.py"
    },
    {
      "id": "data.object-store.manifest",
      "kind": "object-store",
      "direction": "provides",
      "name": "control/manifests/source=<source>/batch_id=<id>.json",
      "status": "current-in-solo-empire",
      "source": "infra/scripts/data_lake/ingest.py"
    },
    {
      "id": "data.object-store.checkpoint",
      "kind": "object-store",
      "direction": "provides",
      "name": "control/checkpoints/source=<source>/batch_id=<id>.json",
      "status": "current-in-solo-empire",
      "source": "infra/scripts/data_lake/ingest.py"
    },
    {
      "id": "data.http.cache",
      "kind": "http",
      "direction": "provides",
      "name": "/v1/cache/{key}",
      "status": "pilot",
      "source": "src/platform_data/app.py",
      "auth": "Verified workspace JWT; cache:read cache:write"
    },
    {
      "id": "data.http.counters",
      "kind": "http",
      "direction": "provides",
      "name": "/v1/counters/{key}/increment",
      "status": "pilot",
      "source": "src/platform_data/app.py",
      "auth": "Verified workspace JWT; counters:write"
    },
    {
      "id": "data.http.documents",
      "kind": "http",
      "direction": "provides",
      "name": "/v1/documents",
      "status": "pilot",
      "source": "src/platform_data/app.py",
      "auth": "Verified workspace JWT; documents:read documents:write"
    },
    {
      "id": "data.http.quotas",
      "kind": "http",
      "direction": "provides",
      "name": "PUT /v1/quotas/{key}",
      "status": "pilot",
      "source": "src/platform_data/app.py",
      "auth": "Verified workspace JWT; quotas:write"
    },
    {
      "id": "data.http.reservations",
      "kind": "http",
      "direction": "provides",
      "name": "POST /v1/reservations",
      "status": "pilot",
      "source": "src/platform_data/app.py",
      "auth": "Verified workspace JWT; quotas:reserve"
    },
    {
      "id": "data.http.settle",
      "kind": "http",
      "direction": "provides",
      "name": "POST /v1/reservations/{id}/settle",
      "status": "pilot",
      "source": "src/platform_data/app.py",
      "auth": "Verified workspace JWT; quotas:settle"
    },
    {
      "id": "data.http.release",
      "kind": "http",
      "direction": "provides",
      "name": "POST /v1/reservations/{id}/release",
      "status": "pilot",
      "source": "src/platform_data/app.py",
      "auth": "Verified workspace JWT; quotas:settle"
    },
    {
      "id": "data.http.service-admissions",
      "kind": "http",
      "direction": "provides",
      "name": "POST /v1/service/admissions",
      "status": "pilot",
      "source": "src/platform_data/service_admissions.py",
      "auth": "Service JWT quotas:service in configured system workspace plus independently verified caller JWT ai:generate"
    },
    {
      "id": "data.http.service-settle",
      "kind": "http",
      "direction": "provides",
      "name": "POST /v1/service/admissions/{id}/settle",
      "status": "pilot",
      "source": "src/platform_data/service_admissions.py",
      "auth": "Service JWT quotas:service in configured system workspace plus independently verified caller JWT ai:generate"
    },
    {
      "id": "data.http.service-release",
      "kind": "http",
      "direction": "provides",
      "name": "POST /v1/service/admissions/{id}/release",
      "status": "pilot",
      "source": "src/platform_data/service_admissions.py",
      "auth": "Service JWT quotas:service in configured system workspace plus independently verified caller JWT ai:generate"
    }
  ]
}
